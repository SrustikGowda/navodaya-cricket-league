# Copy to .env.local. Never commit real secrets.

# Postgres connection. When unset, the app uses embedded Postgres in .data/pglite
# so local development still has a real database. Production should set this to
# Supabase or another Postgres service (Railway Postgres works).
# Use the session pooler (port 5432) for migrations. The app sets prepare:false
# so a transaction pooler (port 6543) also works.
DATABASE_URL=

# Public site origin used in magic-link redirects, calendar hosts and share URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth (email magic link). Both are required before sign-in works.
# Leave blank in local development and use ALLOW_LOCAL_AUTH instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for Supabase Storage. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional bucket names when using Supabase Storage.
SUPABASE_STORAGE_BUCKET_PUBLIC=ncl-public
SUPABASE_STORAGE_BUCKET_PRIVATE=ncl-private

# Signs the local development session cookie. Required whenever local auth is on.
# Use at least 16 random characters. Ignored for Supabase sessions.
SESSION_SECRET=

# Comma-separated emails promoted to organizer on sign-in.
# There is no screen that lets someone choose the admin role.
ADMIN_EMAILS=

# Development only. Refused when NODE_ENV=production.
ALLOW_LOCAL_AUTH=false

# Development only. Seeds clearly labeled fictional fixtures. Refused in production.
DEMO_MODE=false

# Optional directory for local uploads when Supabase Storage is not configured.
# On Railway, attach a volume or configure Supabase Storage before the event.
UPLOAD_DIR=.data/uploads

# Optional directory for embedded Postgres.
PGLITE_DIR=.data/pglite
